# 数据库 — 本地默认 SQLite（项目根 data/zhishi.db，不设 DATABASE_URL 时自动解析绝对路径）
# DATABASE_URL=sqlite:///./data/zhishi.db

# 团队联调可切 MySQL
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/my_ai_app

SECRET_KEY=change-me-in-production  # ⚠️ 生产环境必须替换为随机密钥！生成方式：openssl rand -hex 32
ALGORITHM=HS256

# CORS 允许的前端域名（逗号分隔），生产环境必须设置；留空则允许所有来源
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://admin.your-frontend.com

# 内部 API 密钥（用于支付回调等服务间调用）
# INTERNAL_API_KEY=your-internal-secret

# 登录会话持久化在业务数据库的 auth_sessions 表中。
# MemoryCache 仅保存验证码、密码重置令牌和其他短期运行态数据，无需 Redis。

# Tina LLM / Question Agent（生产环境必须显式配置；不要提交真实密钥）
# 进程环境变量或根目录 .env 优先，根目录 tina.env 仅作兼容回退。
# LLM_API_KEY=replace-with-provider-api-key
# LLM_API_KEYS=key1,key2,key3  # 多 key 逗号分隔（TinaGateway key 池）
# LLM_KEY_MAX_CONCURRENCY=5   # 每个 key 最大并发数
# LLM_KEY_RPM=60              # 每个 key 每分钟最大请求数
# LLM_USER_CONCURRENT_LIMIT=3 # 每用户最大并发 LLM 请求数
# BASE_URL=https://your-openai-compatible-provider.example/v1
# MODEL_NAME=replace-with-model-name

# RAG 后端：local（默认，Chroma 本地向量）| dify
RAG_BACKEND=local
CHROMA_PERSIST_DIR=../data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Dify（仅 RAG_BACKEND=dify 时需要）
DIFY_DATASET_API_KEY=your-dify-dataset-api-key
DIFY_BASE_URL=https://api.dify.ai/v1

LOCAL_STORAGE_DIR=storage
USE_OSS=false
FRONTEND_URL=http://localhost:3000

# 上传大小限制（字节）；0 = 不限制
# DEBUG_MAX_UPLOAD_SIZE：演示/本地存储模式下的单文件上限，默认 0
# DEBUG_MAX_UPLOAD_SIZE=0
# DIFY_MAX_UPLOAD_SIZE：提交 Dify 前的本地预检上限，默认 0（不预检）
# 仅当显式设置时才拦截；Dify Cloud 自身可能仍有单文件大小限制
# DIFY_MAX_UPLOAD_SIZE=15728640

# OCR 后端：local（默认，PaddleOCR 本地）| baidu | auto（先 Paddle 再百度）
OCR_BACKEND=local
# 扫描 PDF OCR 最多处理页数；0 = 全页（也可在 backend/config.json 配置 pdf_ocr_max_pages）
PDF_OCR_MAX_PAGES=50

# 非密钥运行时配置见 backend/config.json（OCR 并行数、异步 pipeline、上传大小等）
