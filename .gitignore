# ============================================================
# .gitignore - zhixu-backend
# ============================================================

# ------------------------------
# 操作系统生成的文件
# ------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# ------------------------------
# IDE 和编辑器配置文件
# ------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.swm
*.bak
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ------------------------------
# 依赖目录
# ------------------------------
node_modules/
vendor/
__pycache__/
.venv/
venv/
env/
.pip/
.npm/
.yarn/

# ------------------------------
# 环境变量文件
# ------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ------------------------------
# 构建输出目录
# ------------------------------
dist/
build/
out/
*.egg-info/
.eggs/
develop-eggs/
sdist/
wheels/

# ------------------------------
# 日志文件
# ------------------------------
*.log
logs/

# ------------------------------
# 临时文件
# ------------------------------
*.tmp
*.temp
tmp/

# ------------------------------
# Python 编译文件
# ------------------------------
*.pyc
*.pyo
*.pyd
*.so

# ------------------------------
# 测试与覆盖率
# ------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------
# 数据库文件
# ------------------------------
*.sqlite3
*.db

# ------------------------------
# 本地工具与项目数据
# ------------------------------
.workbuddy/
.agents/
.codegraph/
